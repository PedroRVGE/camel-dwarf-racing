# =============================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
#  Copiala y completala antes de levantar nada:
#
#      cp .env.example .env
#
#  El archivo .env NO se sube al repositorio (.gitignore lo excluye); este si,
#  para que cualquiera que clone el proyecto sepa que valores hacen falta.
#  Por eso aca no va ninguna credencial real, solo ejemplos.
#
#  Docker Compose lee el .env solo, por estar al lado del compose.yml.
# =============================================================================


# -----------------------------------------------------------------------------
#  Base de datos
# -----------------------------------------------------------------------------
# Estos tres los usa el contenedor de Postgres para crear la base la primera vez,
# y la aplicacion para conectarse.
DB_NAME=camelracing
DB_USER=camelracing
DB_PASSWORD=cambiame

# DB_HOST NO esta aca a proposito, aunque el enunciado lo liste.
# Dentro de la red de Docker el host de la base es siempre "db", el nombre del
# servicio en compose.yml, y eso no tiene por que ser configurable: si se cambia,
# la app deja de encontrar la base. Para correr contra un Postgres propio fuera de
# Docker esta el perfil "dev" (application-dev.yml), que trae su propia URL.


# -----------------------------------------------------------------------------
#  Puertos publicados en TU maquina
# -----------------------------------------------------------------------------
# Los de adentro de cada contenedor son fijos (5432 Postgres, 8080 la app, 8080
# Keycloak, 80 nginx) y no dependen de esto. Estos son los del host.
#
# Si ya tenes algo ocupando alguno —otro Postgres, otro proyecto de la materia—
# cambia el numero aca y listo, no hay que tocar ningun otro archivo.
DB_PORT=5432
APP_PORT=8080
KEYCLOAK_PORT=8180
WEB_PORT=3000


# -----------------------------------------------------------------------------
#  Keycloak (consola de administracion)
# -----------------------------------------------------------------------------
# Usuario del panel de Keycloak en http://localhost:8180, NO un usuario de la
# aplicacion. Los usuarios de la app (admin / organizer / viewer) los crea el
# realm que se importa desde keycloak/.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiame


# -----------------------------------------------------------------------------
#  Frontend
# -----------------------------------------------------------------------------
# A donde le pega el navegador. Ojo que es la direccion vista DESDE EL NAVEGADOR
# y no desde adentro de la red de Docker: para el navegador, la API es localhost.
#
# Es el unico valor que hay que acordarse de cambiar a mano si cambias APP_PORT:
# el resto se deriva solo. Si aca dice 8080 y APP_PORT dice 8090, el frontend
# carga bien y despues falla en cada pedido con un error de conexion.
#
# La direccion de Keycloak que usa el frontend NO esta aca: compose la arma con
# KEYCLOAK_PORT, que ya esta mas arriba. Y su cliente (camelracing-web) tampoco:
# no es configurable porque tiene que coincidir con el que declara el realm.
API_BASE_URL=http://localhost:8080


# -----------------------------------------------------------------------------
#  Reglas de negocio configurables
# -----------------------------------------------------------------------------
# Cuantos competidores como maximo puede tener un equipo. El enunciado pide que
# este limite sea configurable y no una constante escondida en el codigo.
#
# Bajarlo no toca los equipos que ya existen: solo se valida al agregar un
# integrante nuevo, asi que un equipo de cinco sigue siendo valido si despues se
# pone el limite en tres. Simplemente no se le puede sumar nadie mas.
TEAM_MAX_MEMBERS=5


# -----------------------------------------------------------------------------
#  Sobre JWT_SECRET y JWT_EXPIRATION
# -----------------------------------------------------------------------------
# El enunciado los lista, pero en este proyecto no existen, y no es un olvido.
#
# Esas dos variables tienen sentido cuando la propia aplicacion emite los tokens:
# hay que decirle con que clave firmarlos y cuanto duran. Aca los tokens los emite
# Keycloak, que los firma con un par de claves RSA que genera el mismo y publica
# en su endpoint de JWKS. La aplicacion nunca firma nada: solo baja la clave
# publica y verifica.
#
# Poner un JWT_SECRET seria peor que no ponerlo: quedaria un secreto sin uso en el
# .env, dando a entender que hay una clave compartida que en realidad no existe.
# La duracion del token se configura en el realm (accessTokenLifespan), en
# keycloak/realm-camelracing.json.
